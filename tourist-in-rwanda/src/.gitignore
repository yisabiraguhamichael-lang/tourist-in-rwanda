cd /d C:\reactproject

(
echo # Dependencies
echo node_modules/
echo **/node_modules/
echo.
echo # Build output
echo dist/
echo **/dist/
echo build/
echo **/build/
echo.
echo # Environment files
echo **/.env
echo **/.env.local
echo **/.env.*.local
echo !**/.env.example
echo.
echo # Logs
echo *.log
echo npm-debug.log*
echo.
echo # OS
echo .DS_Store
echo Thumbs.db
echo desktop.ini
echo.
echo # IDE
echo .vscode/
echo .idea/
echo *.swp
) > .gitignore

type .gitignore